APP_NAME="TeaCare"
APP_URL=https://tea.example.com
APP_ENV=production
APP_TIMEZONE=Asia/Dhaka
APP_SECRET=replace-with-a-random-64-character-hex-string

# Database (use 127.0.0.1 or localhost for cPanel; mysql-main for Docker external DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teacare_db
DB_USERNAME=teacare_user
DB_PASSWORD=replace-with-strong-database-password

# Web Push (VAPID) - auto-generated when running bin/generate-vapid.php
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Initial Admin Account (used only once when the users table is empty)
DEFAULT_ADMIN_ID=ADMIN001
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password
DEFAULT_DEMO_PASSWORD=replace-with-strong-demo-password
SHOW_DEMO_LOGINS=false
